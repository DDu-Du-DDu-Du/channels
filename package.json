{
  "name": "channels",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "license": "MIT",
  "scripts": {
    "start": "cross-env DEBUG_COLORS=0 expo start",
    "start:dev": "cross-env DEBUG_COLORS=0 EXPO_PUBLIC_API_BASE_URL=https://dev.api.mo-doo.com expo start",
    "start:prod": "cross-env DEBUG_COLORS=0 EXPO_PUBLIC_API_BASE_URL=https://api.mo-doo.com expo start",
    "start:web": "cross-env DEBUG_COLORS=0 expo start --web",
    "start:web:dev": "cross-env DEBUG_COLORS=0 EXPO_PUBLIC_API_BASE_URL=https://dev.api.mo-doo.com expo start --web",
    "start:web:prod": "cross-env DEBUG_COLORS=0 EXPO_PUBLIC_API_BASE_URL=https://api.mo-doo.com expo start --web",
    "dev": "cross-env DEBUG_COLORS=0 EXPO_PUBLIC_LOGIN_DISABLED='true' expo start",
    "dev:dev": "cross-env DEBUG_COLORS=0 EXPO_PUBLIC_LOGIN_DISABLED='true' EXPO_PUBLIC_API_BASE_URL=https://dev.api.mo-doo.com expo start",
    "dev:prod": "cross-env DEBUG_COLORS=0 EXPO_PUBLIC_LOGIN_DISABLED='true' EXPO_PUBLIC_API_BASE_URL=https://api.mo-doo.com expo start",
    "dev:web": "cross-env DEBUG_COLORS=0 EXPO_PUBLIC_LOGIN_DISABLED='true' expo start --web",
    "dev:web:dev": "cross-env DEBUG_COLORS=0 EXPO_PUBLIC_LOGIN_DISABLED='true' EXPO_PUBLIC_API_BASE_URL=https://dev.api.mo-doo.com expo start --web",
    "dev:web:prod": "cross-env DEBUG_COLORS=0 EXPO_PUBLIC_LOGIN_DISABLED='true' EXPO_PUBLIC_API_BASE_URL=https://dapi.mo-doo.com expo start --web",
    "serve": "expo export --platform web --clear && expo serve",
    "serve:dev": "cross-env EXPO_PUBLIC_API_BASE_URL=https://dev.api.mo-doo.com expo export --platform web --clear && expo serve",
    "serve:prod": "cross-env EXPO_PUBLIC_API_BASE_URL=https://api.mo-doo.com expo export --platform web --clear && expo serve",
    "android": "expo start --android",
    "ios": "cross-env DEBUG_COLORS=0 expo start --ios",
    "storybook:web": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "storybook-generate": "sb-rn-get-stories",
    "storybook": "cross-env EXPO_PUBLIC_STORYBOOK_ENABLED='true' expo start --web",
    "storybook:ios": "cross-env EXPO_PUBLIC_STORYBOOK_ENABLED='true' expo start --ios",
    "storybook:android": "cross-env EXPO_PUBLIC_STORYBOOK_ENABLED='true' expo start --android",
    "lint": "expo lint . --fix",
    "prepare": "husky"
  },
  "dependencies": {
    "@babel/plugin-proposal-export-namespace-from": "^7.18.9",
    "@gorhom/bottom-sheet": "^5.2.6",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.6.0",
    "@react-native-community/slider": "5.1.2",
    "@react-native-kakao/core": "^2.4.2",
    "@react-native-kakao/user": "^2.4.2",
    "@react-native-picker/picker": "2.11.4",
    "@tanstack/react-query": "^5.90.5",
    "@types/xdate": "^0.8.35",
    "dotenv": "^17.4.2",
    "expo": "^55.0.17",
    "expo-build-properties": "~55.0.13",
    "expo-constants": "~55.0.15",
    "expo-font": "~55.0.6",
    "expo-image": "~55.0.9",
    "expo-image-picker": "~55.0.19",
    "expo-linking": "~55.0.14",
    "expo-notifications": "~55.0.20",
    "expo-router": "~55.0.13",
    "expo-secure-store": "~55.0.13",
    "expo-splash-screen": "~55.0.19",
    "expo-sqlite": "~55.0.15",
    "expo-status-bar": "~55.0.5",
    "firebase": "^12.11.0",
    "nativewind": "^4.2.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-hook-form": "^7.66.0",
    "react-native": "0.83.6",
    "react-native-calendars": "^1.1313.0",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.7.4",
    "tailwind-scrollbar-hide": "^4.0.0",
    "tailwindcss-animated": "^2.0.0",
    "uuid": "^13.0.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/plugin-transform-class-static-block": "^7.27.1",
    "@babel/preset-env": "^7.25.4",
    "@chromatic-com/storybook": "^4.0.0",
    "@dev-plugins/react-query": "^0.4.0",
    "@expo/metro-runtime": "~6.1.2",
    "@storybook/addon-docs": "^10.0.0",
    "@storybook/addon-ondevice-actions": "^10.0.0",
    "@storybook/addon-ondevice-backgrounds": "^10.0.0",
    "@storybook/addon-ondevice-controls": "^10.0.0",
    "@storybook/addon-ondevice-notes": "^10.0.0",
    "@storybook/react": "^10.0.0",
    "@storybook/react-native": "^10.0.0",
    "@storybook/react-native-web-vite": "^10.0.0",
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "@types/react": "~19.1.10",
    "babel-plugin-react-docgen-typescript": "^1.5.1",
    "cross-env": "^10.0.0",
    "eslint": "^9.38.0",
    "eslint-config-expo": "^10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.6",
    "playwright": "^1.59.1",
    "prettier-plugin-tailwindcss": "^0.5.11",
    "storybook": "^10.0.0",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.9.2",
    "vite": "^7.1.12"
  },
  "resolutions": {
    "react-docgen-typescript": "2.2.2"
  },
  "overrides": {
    "react-docgen-typescript": "2.2.2"
  },
  "pnpm": {
    "overrides": {
      "react-docgen-typescript": "2.2.2"
    }
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "prettier --cache --write",
      "eslint --cache --fix --max-warnings=0"
    ]
  },
  "private": true
}
